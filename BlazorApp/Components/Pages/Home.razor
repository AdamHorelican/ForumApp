@page "/"
@inject NavigationManager Navigation

<PageTitle>Home</PageTitle>

<h1>Forum</h1>

<AuthorizeView>
    <Authorized>
        <p>Hello, @context.User.Identity?.Name</p>
    </Authorized>
    <NotAuthorized>
        <p>You are not logged in.</p>
        <button class="btn btn-primary" @onclick='() => Navigation.NavigateTo("login")'>Go to login</button>
    </NotAuthorized>
</AuthorizeView>