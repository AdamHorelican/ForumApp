@page "/posts/{Id:int}"
@inject IPostService PostService
@inject IUserService UserService
@inject ICommentService CommentService

<PageTitle>@(post?.Title ?? "Post")</PageTitle>

@if (loadError is not null)
{
    <div class="alert alert-danger">@loadError</div>
}
else if (post is null)
{
    <p>Loading...</p>
}
else
{
    <h1>@post.Title</h1>
    <p class="text-muted">By @GetUsername(post.UserId)</p>
    <p style="white-space: pre-wrap">@post.Body</p>

    <h2 class="h4 mt-4">Comments</h2>

    @if (comments.Count == 0)
    {
        <p>No comments yet.</p>
    }
    else
    {
        <ul class="list-group mb-3">
            @foreach (CommentDto comment in comments)
            {
                <li class="list-group-item">
                    <strong>@GetUsername(comment.UserId):</strong> @comment.Body
                </li>
            }
        </ul>
    }

    <AuthorizeView>
        <Authorized>
            <div class="mb-3">
                <label class="form-label" for="comment">Add a comment</label>
                <textarea id="comment" class="form-control" rows="3" @bind="newComment"></textarea>
            </div>

            <button class="btn btn-primary" @onclick="AddCommentAsync">Add comment</button>

            @if (commentError is not null)
            {
                <div class="alert alert-danger mt-3">@commentError</div>
            }
        </Authorized>
        <NotAuthorized>
            <p><a href="login">Log in</a> to add a comment.</p>
        </NotAuthorized>
    </AuthorizeView>
}

@code {
    [Parameter]
    public int Id { get; set; }

    [CascadingParameter]
    public Task<AuthenticationState> State { get; set; } = null!;

    private PostDto? post;
    private List<CommentDto> comments = new();
    private Dictionary<int, string> usernames = new();
    private string newComment = "";
    private string? loadError;
    private string? commentError;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            post = await PostService.GetPostAsync(Id);
            comments = await CommentService.GetCommentsForPostAsync(Id);
            List<UserDto> users = await UserService.GetUsersAsync();
            usernames = users.ToDictionary(u => u.Id, u => u.Username);
        }
        catch (Exception e)
        {
            loadError = e.Message;
        }
    }

    private async Task AddCommentAsync()
    {
        commentError = null;

        if (string.IsNullOrWhiteSpace(newComment))
        {
            commentError = "Comment cannot be empty.";
            return;
        }

        try
        {
            AuthenticationState authenticationState = await State;
            int userId = int.Parse(authenticationState.User.FindFirst("Id")!.Value);

            CommentDto created = await CommentService.AddCommentAsync(new CreateCommentDto
            {
                Body = newComment.Trim(),
                UserId = userId,
                PostId = Id
            });

            comments.Add(created);
            newComment = "";
        }
        catch (Exception e)
        {
            commentError = e.Message;
        }
    }

    private string GetUsername(int userId)
    {
        return usernames.GetValueOrDefault(userId, "[unknown user]");
    }
}